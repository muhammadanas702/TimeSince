<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Widget settings"
            android:textColor="@color/fg"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Every change shows in the preview straight away."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/preview_backdrop"
            android:padding="14dp">

            <FrameLayout
                android:id="@+id/preview_host"
                android:layout_width="match_parent"
                android:layout_height="130dp" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.16"
            android:text="Name and date"
            android:textAllCaps="true"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_label"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="@string/hint_label"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="40"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="@color/fg"
            android:textColorHint="@color/muted"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_date"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outline"
                android:stateListAnimator="@null"
                android:text="Date"
                android:textAllCaps="false"
                android:textColor="@color/fg"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_time"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outline"
                android:stateListAnimator="@null"
                android:text="Time"
                android:textAllCaps="false"
                android:textColor="@color/fg"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_since_alert"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_outline"
            android:stateListAnimator="@null"
            android:text="Alert when the date arrives: Off"
            android:textAllCaps="false"
            android:textColor="@color/fg"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="For a date in the future. When the countdown reaches it you get a notification, or your phone rings (up to one minute, until you tap or swipe it away). On some phones you must also allow the app to run in the background."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.16"
            android:text="Style"
            android:textAllCaps="true"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/st_detailed"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outline"
                android:stateListAnimator="@null"
                android:text="Detailed"
                android:textAllCaps="false"
                android:textColor="@color/fg"
                android:textSize="14sp" />

            <Button
                android:id="@+id/st_days"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outline"
                android:stateListAnimator="@null"
                android:text="Total days"
                android:textAllCaps="false"
                android:textColor="@color/fg"
                android:textSize="14sp" />

            <Button
                android:id="@+id/st_compact"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outline"
                android:stateListAnimator="@null"
                android:text="Compact"
                android:textAllCaps="false"
                android:textColor="@color/fg"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.16"
            android:text="Color theme"
            android:textAllCaps="true"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/presets_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/btn_c_bg"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_outline"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="16dp"
            android:stateListAnimator="@null"
            android:text="Background color"
            android:textAllCaps="false"
            android:textColor="@color/fg"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_c_fg"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_outline"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="16dp"
            android:stateListAnimator="@null"
            android:text="Text color"
            android:textAllCaps="false"
            android:textColor="@color/fg"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_c_accent"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_outline"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="16dp"
            android:stateListAnimator="@null"
            android:text="Accent color"
            android:textAllCaps="false"
            android:textColor="@color/fg"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.16"
            android:text="Transparency"
            android:textAllCaps="true"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Background opacity: 100%"
            android:textColor="@color/fg"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/sb_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="100" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="At 0% only the text shows, floating over your wallpaper."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_primary"
            android:stateListAnimator="@null"
            android:text="Save widget"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
