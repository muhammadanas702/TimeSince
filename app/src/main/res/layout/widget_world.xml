<?xml version="1.0" encoding="utf-8"?>
<!-- World clock. Up to three rows, each with a city, the weekday there and the time there. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape"
        android:tint="@color/surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:id="@+id/r1_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/r1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Lahore"
                android:textColor="@color/fg"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/r1_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE"
                android:format24Hour="EEE"
                android:paddingEnd="10dp"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:timeZone="Asia/Karachi" />

            <TextClock
                android:id="@+id/r1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:format12Hour="h:mm a"
                android:format24Hour="h:mm a"
                android:maxLines="1"
                android:textColor="@color/accent"
                android:textSize="22sp"
                android:timeZone="Asia/Karachi" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/r2_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/r2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="London"
                android:textColor="@color/fg"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/r2_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE"
                android:format24Hour="EEE"
                android:paddingEnd="10dp"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:timeZone="Europe/London" />

            <TextClock
                android:id="@+id/r2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:format12Hour="h:mm a"
                android:format24Hour="h:mm a"
                android:maxLines="1"
                android:textColor="@color/accent"
                android:textSize="22sp"
                android:timeZone="Europe/London" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/r3_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/r3_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="New York"
                android:textColor="@color/fg"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/r3_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE"
                android:format24Hour="EEE"
                android:paddingEnd="10dp"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:timeZone="America/New_York" />

            <TextClock
                android:id="@+id/r3_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:format12Hour="h:mm a"
                android:format24Hour="h:mm a"
                android:maxLines="1"
                android:textColor="@color/accent"
                android:textSize="22sp"
                android:timeZone="America/New_York" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
