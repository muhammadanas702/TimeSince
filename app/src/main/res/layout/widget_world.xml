<?xml version="1.0" encoding="utf-8"?>
<!-- World clock, frosted-glass design: the phone's own time in a colored pill, the date, then
     up to six city pills (short name on the left, that city's time on the right).
     Rows share the height equally; the code hides the rows that are not in use. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/world_shape" />

    <ImageView
        android:id="@+id/w_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/world_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="11dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/p_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/pill_shape" />

            <TextClock
                android:id="@+id/wc_time"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:format12Hour="hh : mm"
                android:format24Hour="hh : mm"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextClock
            android:id="@+id/wc_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:format12Hour="EEE, yyyy, MMM d,a"
            android:format24Hour="EEE, yyyy, MMM d,a"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:textColor="#9EFFFFFF"
            android:textSize="17.5sp" />

        <FrameLayout
            android:id="@+id/r1_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/r1_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/pill_shape" />

            <!-- A TextClock whose format is set by code to a fixed text, so the name is drawn exactly like the time. -->
            <TextClock
                android:id="@+id/r1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="27dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextClock
                android:id="@+id/r1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="40dp"
                android:format12Hour="hh:mm a"
                android:format24Hour="hh:mm a"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/r2_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/r2_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/pill_shape" />

            <!-- A TextClock whose format is set by code to a fixed text, so the name is drawn exactly like the time. -->
            <TextClock
                android:id="@+id/r2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="27dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextClock
                android:id="@+id/r2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="40dp"
                android:format12Hour="hh:mm a"
                android:format24Hour="hh:mm a"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/r3_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/r3_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/pill_shape" />

            <!-- A TextClock whose format is set by code to a fixed text, so the name is drawn exactly like the time. -->
            <TextClock
                android:id="@+id/r3_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="27dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextClock
                android:id="@+id/r3_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="40dp"
                android:format12Hour="hh:mm a"
                android:format24Hour="hh:mm a"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/r4_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/r4_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/pill_shape" />

            <!-- A TextClock whose format is set by code to a fixed text, so the name is drawn exactly like the time. -->
            <TextClock
                android:id="@+id/r4_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="27dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextClock
                android:id="@+id/r4_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="40dp"
                android:format12Hour="hh:mm a"
                android:format24Hour="hh:mm a"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/r5_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/r5_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/pill_shape" />

            <!-- A TextClock whose format is set by code to a fixed text, so the name is drawn exactly like the time. -->
            <TextClock
                android:id="@+id/r5_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="27dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextClock
                android:id="@+id/r5_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="40dp"
                android:format12Hour="hh:mm a"
                android:format24Hour="hh:mm a"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/r6_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/r6_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/pill_shape" />

            <!-- A TextClock whose format is set by code to a fixed text, so the name is drawn exactly like the time. -->
            <TextClock
                android:id="@+id/r6_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="27dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextClock
                android:id="@+id/r6_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="40dp"
                android:format12Hour="hh:mm a"
                android:format24Hour="hh:mm a"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
