<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/config_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event countdown settings"
            android:textColor="@color/fg"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Every change shows in the preview straight away."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/preview_backdrop"
            android:padding="14dp">

            <FrameLayout
                android:id="@+id/preview_host"
                android:layout_width="match_parent"
                android:layout_height="165dp" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.16"
            android:text="Widget name"
            android:textAllCaps="true"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_widget_title"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="Optional, e.g. Mid exam dates"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:maxLength="30"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="@color/fg"
            android:textColorHint="@color/muted"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.16"
            android:text="Events"
            android:textAllCaps="true"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Add as many as you like (up to 30). An event needs a date. Tick Every year for birthdays and anniversaries, so they count to the next one."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/events_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btn_add_event"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_outline"
            android:stateListAnimator="@null"
            android:text="+ Add another event"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_per_page"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_outline"
            android:stateListAnimator="@null"
            android:text="Shown at once: 4 events"
            android:textAllCaps="false"
            android:textColor="@color/fg"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_per_page_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="With more events than that, the widget gets arrows to flip between pages. More rows need a taller widget: stretch it on the home screen."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.16"
            android:text="Alerts"
            android:textAllCaps="true"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_notify_time"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_outline"
            android:stateListAnimator="@null"
            android:text="All-day alert time: 9:00 AM"
            android:textAllCaps="false"
            android:textColor="@color/fg"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_test_alert"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_outline"
            android:stateListAnimator="@null"
            android:text="Send a test alert"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Give an event a Time to count down to the minute: under a day to go the widget ticks live, and the alert comes at that time. Events without a time count days and alert at the all-day alert time. Set Alert to Notification or Ringtone; a ringtone alert rings with your phone's ringtone until you tap or swipe it away (at most one minute). The alerts of a widget stop if you remove the widget. On some phones you also need to allow this app to run in the background (auto-start or battery settings)."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <include
            layout="@layout/view_look"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_primary"
            android:stateListAnimator="@null"
            android:text="Save widget"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
