<?xml version="1.0" encoding="utf-8"?>
<!-- Color theme and transparency controls. Used through LookPanel by the clock-style widgets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:letterSpacing="0.16"
        android:text="Color theme"
        android:textAllCaps="true"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/presets_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <Button
        android:id="@+id/btn_c_bg"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_outline"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="16dp"
        android:stateListAnimator="@null"
        android:text="Background color"
        android:textAllCaps="false"
        android:textColor="@color/fg"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btn_c_fg"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_outline"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="16dp"
        android:stateListAnimator="@null"
        android:text="Text color"
        android:textAllCaps="false"
        android:textColor="@color/fg"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btn_c_accent"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_outline"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="16dp"
        android:stateListAnimator="@null"
        android:text="Accent color"
        android:textAllCaps="false"
        android:textColor="@color/fg"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:letterSpacing="0.16"
        android:text="Transparency"
        android:textAllCaps="true"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_opacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Background opacity: 100%"
        android:textColor="@color/fg"
        android:textSize="15sp" />

    <SeekBar
        android:id="@+id/sb_opacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="100" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="At 0% only the text shows, floating over your wallpaper."
        android:textColor="@color/muted"
        android:textSize="12sp" />
</LinearLayout>
