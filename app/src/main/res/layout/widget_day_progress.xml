<?xml version="1.0" encoding="utf-8"?>
<!-- Day Progress: up to four rows, each a label, a bar (a track and a fill that the widget clips to the
     right length) and the percent. Rows that are switched off are hidden by code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape"
        android:tint="@color/surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:id="@+id/p1_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/p1_label"
                android:layout_width="58dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Today"
                android:textColor="@color/fg"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/p1_track"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/bar_pill" />

                <ImageView
                    android:id="@+id/p1_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/bar_fill" />
            </FrameLayout>

            <TextView
                android:id="@+id/p1_pct"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/p2_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/p2_label"
                android:layout_width="58dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Week"
                android:textColor="@color/fg"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/p2_track"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/bar_pill" />

                <ImageView
                    android:id="@+id/p2_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/bar_fill" />
            </FrameLayout>

            <TextView
                android:id="@+id/p2_pct"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/p3_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/p3_label"
                android:layout_width="58dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Month"
                android:textColor="@color/fg"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/p3_track"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/bar_pill" />

                <ImageView
                    android:id="@+id/p3_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/bar_fill" />
            </FrameLayout>

            <TextView
                android:id="@+id/p3_pct"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/p4_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/p4_label"
                android:layout_width="58dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Year"
                android:textColor="@color/fg"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/p4_track"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/bar_pill" />

                <ImageView
                    android:id="@+id/p4_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/bar_fill" />
            </FrameLayout>

            <TextView
                android:id="@+id/p4_pct"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
