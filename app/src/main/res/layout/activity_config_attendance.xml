<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Attendance settings"
            android:textColor="@color/fg"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Every change shows in the preview straight away."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/preview_backdrop"
            android:padding="14dp">

            <FrameLayout
                android:id="@+id/preview_host"
                android:layout_width="match_parent"
                android:layout_height="170dp" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.16"
            android:text="Subjects"
            android:textAllCaps="true"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_subjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:gravity="top|start"
            android:hint="One subject per line"
            android:inputType="textMultiLine|textCapWords"
            android:maxLength="400"
            android:minLines="5"
            android:padding="14dp"
            android:textColor="@color/fg"
            android:textColorHint="@color/muted"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Up to 6 subjects, one per line. To start from your real counts, write them after the name: Database 12/14 means 12 classes attended out of 14. In the widget, tap the tick when you attended a class and the cross when you missed it. The hint shows how many classes you can still miss, or must attend in a row, to reach your goal."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_target"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_outline"
            android:stateListAnimator="@null"
            android:text="Attendance goal: 75%"
            android:textAllCaps="false"
            android:textColor="@color/fg"
            android:textSize="15sp" />

        <include
            layout="@layout/view_look"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_primary"
            android:stateListAnimator="@null"
            android:text="Save widget"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
