<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Class Timetable settings"
            android:textColor="@color/fg"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Every change shows in the preview straight away."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/preview_backdrop"
            android:padding="14dp">

            <FrameLayout
                android:id="@+id/preview_host"
                android:layout_width="match_parent"
                android:layout_height="170dp" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.16"
            android:text="Day"
            android:textAllCaps="true"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-2dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_tt_d1"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outline"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:stateListAnimator="@null"
                android:text="Mon"
                android:textAllCaps="false"
                android:textColor="@color/fg"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btn_tt_d2"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outline"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:stateListAnimator="@null"
                android:text="Mon"
                android:textAllCaps="false"
                android:textColor="@color/fg"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btn_tt_d3"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outline"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:stateListAnimator="@null"
                android:text="Mon"
                android:textAllCaps="false"
                android:textColor="@color/fg"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btn_tt_d4"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outline"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:stateListAnimator="@null"
                android:text="Mon"
                android:textAllCaps="false"
                android:textColor="@color/fg"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btn_tt_d5"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outline"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:stateListAnimator="@null"
                android:text="Mon"
                android:textAllCaps="false"
                android:textColor="@color/fg"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btn_tt_d6"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outline"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:stateListAnimator="@null"
                android:text="Mon"
                android:textAllCaps="false"
                android:textColor="@color/fg"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btn_tt_d7"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outline"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:stateListAnimator="@null"
                android:text="Mon"
                android:textAllCaps="false"
                android:textColor="@color/fg"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_tt_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:gravity="top|start"
            android:hint="e.g. 9:00 AM - 10:30 AM Database (Room 12)"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="800"
            android:minLines="6"
            android:padding="14dp"
            android:textColor="@color/fg"
            android:textColorHint="@color/muted"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="One class per line, starting with the time: 9:00 AM - 10:30 AM Database, 14:00-15:30 Networks lab, or 10 am Physics. The end time is optional. The widget sorts them by time, shows the class that is on now in color, and shows tomorrow when today is over. Pick a day above to edit it; a dot means that day already has classes."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_tt_copy"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_outline"
            android:stateListAnimator="@null"
            android:text="Copy this day to Monday to Friday"
            android:textAllCaps="false"
            android:textColor="@color/fg"
            android:textSize="15sp" />

        <include
            layout="@layout/view_look"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_primary"
            android:stateListAnimator="@null"
            android:text="Save widget"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
