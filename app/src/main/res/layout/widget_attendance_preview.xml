<?xml version="1.0" encoding="utf-8"?>
<!-- What the Attendance Tracker looks like in the widget picker (a fixed sample in the default Peach look). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_card_peach">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="ATTENDANCE"
                android:textColor="#FF7A59"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Goal 75%"
                android:textColor="#994A2A22"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Database"
                    android:textColor="#4A2A22"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Can miss 2 · 12/14"
                    android:textColor="#994A2A22"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="85%"
                android:textColor="#FF7A59"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:padding="3dp"
                android:src="@drawable/ic_check_on"
                android:tint="#FF7A59" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:alpha="0.55"
                android:importantForAccessibility="no"
                android:padding="3dp"
                android:src="@drawable/ic_cross"
                android:tint="#4A2A22" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Networks"
                    android:textColor="#4A2A22"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Attend next 3 · 8/12"
                    android:textColor="#994A2A22"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="66%"
                android:textColor="#E5484D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:padding="3dp"
                android:src="@drawable/ic_check_on"
                android:tint="#FF7A59" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:alpha="0.55"
                android:importantForAccessibility="no"
                android:padding="3dp"
                android:src="@drawable/ic_cross"
                android:tint="#4A2A22" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Maths"
                    android:textColor="#4A2A22"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Can miss 5 · 18/19"
                    android:textColor="#994A2A22"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="94%"
                android:textColor="#FF7A59"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:padding="3dp"
                android:src="@drawable/ic_check_on"
                android:tint="#FF7A59" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:alpha="0.55"
                android:importantForAccessibility="no"
                android:padding="3dp"
                android:src="@drawable/ic_cross"
                android:tint="#4A2A22" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
