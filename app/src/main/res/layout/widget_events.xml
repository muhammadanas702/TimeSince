<?xml version="1.0" encoding="utf-8"?>
<!-- Event countdown. Up to four rows: event name, its date, and the days left. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape"
        android:tint="@color/surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:id="@+id/e1_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/e1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Birthday"
                android:textColor="@color/fg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/e1_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingEnd="10dp"
                android:text="12 Dec 2026"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/e1_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:minWidth="64dp"
                android:text="48 days"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/e2_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/e2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Exam week"
                android:textColor="@color/fg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/e2_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingEnd="10dp"
                android:text="2 Nov 2026"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/e2_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:minWidth="64dp"
                android:text="8 days"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/e3_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/e3_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Eid"
                android:textColor="@color/fg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/e3_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingEnd="10dp"
                android:text="9 Jan 2027"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/e3_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:minWidth="64dp"
                android:text="76 days"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/e4_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
        android:visibility="gone">

            <TextView
                android:id="@+id/e4_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/fg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/e4_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingEnd="10dp"
                android:text=""
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/e4_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:minWidth="64dp"
                android:text=""
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
