<?xml version="1.0" encoding="utf-8"?>
<!-- Quote of the Day: the quote in a soft serif italic, the author under it (when there is one), and a small
     refresh icon in the corner for the next quote. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape"
        android:tint="@color/surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="26dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/q_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:gravity="center"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="6"
            android:text="Small steps still move you forward."
            android:textColor="@color/fg"
            android:textSize="16sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/q_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/q_next"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:contentDescription="Next quote"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_refresh" />
</FrameLayout>
