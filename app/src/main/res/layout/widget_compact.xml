<?xml version="1.0" encoding="utf-8"?>
<!-- Style: Compact. One row: name and date, the day count and the live clock. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape"
        android:tint="@color/surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Time since"
                android:textColor="@color/fg"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Since 22 Feb 2026"
                android:textColor="@color/muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="230"
            android:textColor="@color/fg"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/w_total_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="10dp"
            android:text="days"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/w_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/accent"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
